# Copie este arquivo para .env e preencha com dados da SUA conta Ngrok.
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=cole_seu_authtoken_aqui

# Informe apenas o domínio, sem https:// e sem barra no final.
# Domínios: https://dashboard.ngrok.com/domains
NGROK_DOMAIN=seu-dominio.ngrok-free.app

